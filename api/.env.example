# App
NODE_ENV=development
PORT=3000
APP_NAME=Neo Event Equipment Rental
API_PREFIX=api/v1
COMMISSION_RATE=0.10
BOOST_FEE_RWF=3000
BOOST_DURATION_DAYS=7
FREE_LISTING_LIMIT=5

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/neo-db?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-jwt-access-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP (dev mode prints to console)
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# Uploads (local for MVP)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Payments (placeholders)
MOMO_API_URL=
MOMO_API_KEY=change-me-momo-api-key
AIRTEL_API_URL=
AIRTEL_API_KEY=change-me-airtel-api-key

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
